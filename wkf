#!/usr/bin/env bash
WRK_DIR=$(dirname "$(realpath "$0")")
CUR_DIR=$(pwd)

source ${WRK_DIR}/includes/defaults.sh

# FUNCTIONS
greeting(){
  gum style \
        --foreground 212 --border-foreground 212 --border double \
        --align center --width 70 --margin "1 2" --padding "1 2" \
        'Absolute Awesome Workflow Manager' \
        "McClane Mighty Software - $(date +%Y)" \
        "Apache License 2.0"
  echo
}

list_local_workflows(){
  if [ -f ${CUR_DIR}/workflows ]; then
    cat ${CUR_DIR}/workflows | sed '/^ *#/d;s/^ *//' | cut -d '=' -f 1
  fi
}

run_local_command(){
  local command_name=$1
  local command_line
 
  if [ -f ${CUR_DIR}/workflows ]; then
    log_info "Finding '$command_name' in the local workflows..."
    command_line=$(
      cat ${CUR_DIR}/workflows |
        sed "/^$command_name/"'!d;s/^ *//' |
        cut -d '=' -f 2
    )
    if [ ! "$command_line" = "" ]; then
      log_and_run "Triggering local workflow..." \
        $command_line || return 2
    else
        return 1
    fi
  else
    return 1
  fi
}

list_commands(){
  list_local_workflows
  for f in "${WRK_DIR}/workflows/"*.sh scripts/local/*.sh; do
    [ -f "$f" ] || continue
    basename "$f" .sh
  done
}

choose_command(){
  list_commands | gum filter \
    --limit=1 \
    --header.foreground=15 \
    --height=7 \
    --placeholder="What do you wanna do?"
}

run_command(){
  local command=$1

  run_local_command $command
  local_cmd_status="$?"

  if [ "$local_cmd_status" -eq 2 ]; then
    return 2
  elif [ "$local_cmd_status" -eq 1 ]; then
    log_info "Finding script for command: $command"
    local script="${WRK_DIR}/workflows/${command}.sh"
    [ -x "$script" ] || script="scripts/local/${command}.sh"

    if [ -x "$script" ]; then
      log_info "Triggering command '$command'..."
      WRK_DIR="${WRK_DIR}" CUR_DIR="${CUR_DIR}" PWD="${CUR_DIR}" $script
    else
      log_error "Could not execute the command '$command'."
      exit 1
    fi
  fi
}

# MAIN
[ "$DEBUG" = "true" ] || clear

greeting
log_temp "Initializing workflows..." 2
log_info "All good! We are ready to rock."
cat <<EOF | display_markdown
- current workspace: $CUR_DIR
- current branch: $(fetch_current_branch)
EOF
echo

while true; do
  command=$(choose_command)
  if ! run_command $command; then
    log_temp "It seems like something went wrong..." 3
  fi
  echo
done
